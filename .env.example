# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
# SERVER-ONLY secret (Supabase → Project Settings → API → service_role / secret key).
# Used only to save AI-written community replies. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI API Keys
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional: route AI calls through a corporate gateway/proxy (leave unset normally)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Weather APIs
OPENWEATHER_API_KEY=your_openweather_api_key
AGRO_API_KEY=your_agro_api_key

# Market Data
DATAGOV_API_KEY=your_datagov_api_key

# Optional — public URL of the deployed site (sent to OpenRouter for attribution)
NEXT_PUBLIC_SITE_URL=https://theagridoctor.vercel.app
